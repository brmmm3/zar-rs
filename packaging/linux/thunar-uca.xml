<?xml version="1.0" encoding="UTF-8"?>
<actions>
  <action>
    <icon>zarg</icon>
    <name>ZAR - Open Archive</name>
    <unique-id>2026061004</unique-id>
    <command>zarg --context open -- %F</command>
    <description>Open the selected ZAR archive</description>
    <range/>
    <patterns>*.zar</patterns>
    <other-files/>
  </action>
  <action>
    <icon>zarg</icon>
    <name>ZAR - Extract here</name>
    <unique-id>2026061005</unique-id>
    <command>zarg --context extract-here -- %F</command>
    <description>Extract the selected ZAR archive beside the archive</description>
    <range/>
    <patterns>*.zar</patterns>
    <other-files/>
  </action>
  <action>
    <icon>zarg</icon>
    <name>ZAR - Extract to...</name>
    <unique-id>2026061006</unique-id>
    <command>zarg --context extract-to -- %F</command>
    <description>Choose a destination for extracting the selected ZAR archive</description>
    <range/>
    <patterns>*.zar</patterns>
    <other-files/>
  </action>
  <action>
    <icon>zarg</icon>
    <name>ZAR - Create Archive...</name>
    <unique-id>2026061001</unique-id>
    <command>zarg --context create -- %F</command>
    <description>Create a ZAR archive from the selected files and folders</description>
    <range/>
    <patterns>*</patterns>
    <directories/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>
  <action>
    <icon>zarg</icon>
    <name>ZAR - Convert to ZAR</name>
    <unique-id>2026061007</unique-id>
    <command>zarg --context convert-to-zar -- %F</command>
    <description>Convert selected archives to ZAR format</description>
    <range/>
    <patterns>*</patterns>
    <directories/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>
  <action>
    <icon>zarg</icon>
    <name>ZAR - Mount Archive</name>
    <unique-id>2026061009</unique-id>
    <command>zarmount --ask %f</command>
    <description>Mount the selected ZAR archive as a virtual filesystem</description>
    <range/>
    <patterns>*.zar</patterns>
    <other-files/>
  </action>
</actions>
