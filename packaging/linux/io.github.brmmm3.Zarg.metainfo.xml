<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.brmmm3.Zarg</id>
  <name>ZAR Archive Manager</name>
  <summary>Create, browse and extract ZAR archives</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <url type="homepage">https://github.com/brmmm3/zar-rs</url>
  <url type="bugtracker">https://github.com/brmmm3/zar-rs/issues</url>
  <description>
    <p>
      zarg is the graphical companion to the zarc command-line tool. It creates,
      appends to, browses and extracts ZAR archives, a block-based format with
      Zstandard compression and optional encryption.
    </p>
  </description>
  <launchable type="desktop-id">io.github.brmmm3.Zarg.desktop</launchable>
  <provides>
    <binary>zarg</binary>
    <binary>zarc</binary>
  </provides>
  <content_rating type="oars-1.1" />
  <releases>
    <release version="0.8.0" date="2026-11-01" />
    <release version="0.7.0" date="2026-10-31" />
  </releases>
</component>