pkgname=zar-rs
pkgver=0.17.1
pkgrel=2
pkgdesc="ZAR archive tools, graphical manager, MCP server and FUSE filesystem"
arch=('x86_64' 'aarch64')
options=('!debug')
url="https://github.com/brmmm3/zar-rs"
license=('MIT OR Apache-2.0')
depends=('fuse3' 'glibc' 'hicolor-icon-theme' 'libgcc' 'libglvnd' 'libx11' 'zstd'
         'libxcb' 'libxcursor' 'libxi' 'libxkbcommon' 'libxkbcommon-x11'
         'libxrandr' 'shared-mime-info' 'wayland')
makedepends=('cargo' 'pkgconf')
optdepends=(
  'xdg-desktop-portal: native file dialogs'
  'xdg-utils: open mounted archives in a file manager'
  'python: install Thunar actions'
)
install=zar-rs.install
_commit=e3909dd480578c5042e26d9e6ae46f063cdab090
source=("$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz")
noextract=("$pkgname-$_commit.tar.gz")
sha256sums=('25e01a8c70e47ca25322d0112af39c038070d656cb01f2336b1f955cbae28551')

prepare() {
  bsdtar -xf "$srcdir/$pkgname-$_commit.tar.gz" -C "$srcdir" \
    --exclude "$pkgname-$_commit/testdata" \
    --exclude "$pkgname-$_commit/testdata/*" || return
  cd "$srcdir/$pkgname-$_commit"
  export CARGO_HOME="$srcdir/cargo"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$srcdir/$pkgname-$_commit"
  export CARGO_HOME="$srcdir/cargo"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export ZSTD_SYS_USE_PKG_CONFIG=1
  cargo build --frozen --release --no-default-features \
    -p zarlib-cli -p zarlib-gui -p zarlib-zcopy -p zarmcp -p zarmount
}

check() {
  cd "$srcdir/$pkgname-$_commit"
  export CARGO_HOME="$srcdir/cargo"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export ZSTD_SYS_USE_PKG_CONFIG=1
  cargo test --frozen --no-default-features \
    -p zarlib -p zarlib-cli -p zarlib-gui -p zarlib-zcopy -p zarmcp -p zarmount
  target/release/zarc --version
  target/release/zcopy --version
  target/release/zarmcp --help >/dev/null
  target/release/zarmount --version
}

package() {
  cd "$srcdir/$pkgname-$_commit"
  install -Dm755 target/release/zarc "$pkgdir/usr/bin/zarc"
  install -Dm755 target/release/zarg "$pkgdir/usr/bin/zarg"
  install -Dm755 target/release/zcopy "$pkgdir/usr/bin/zcopy"
  install -Dm755 target/release/zarmcp "$pkgdir/usr/bin/zarmcp"
  install -Dm755 target/release/zarmount "$pkgdir/usr/bin/zarmount"
  install -Dm644 zarlib-gui/data/zarg.desktop "$pkgdir/usr/share/applications/zarg.desktop"
  install -Dm644 zarlib-gui/data/zarg-error.desktop \
    "$pkgdir/usr/share/applications/zarg-error.desktop"
  install -Dm644 zarlib-gui/assets/zarg-icon.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/zarg.png"
  install -Dm644 zarlib-gui/assets/zarg-error.png \
    "$pkgdir/usr/share/icons/hicolor/64x64/apps/zarg-error.png"
  install -Dm644 zarlib-gui/assets/application-x-zar.png \
    "$pkgdir/usr/share/icons/hicolor/64x64/mimetypes/application-x-zar.png"
  install -Dm644 packaging/linux/zarg-mime.xml "$pkgdir/usr/share/mime/packages/zar-rs.xml"
  install -Dm644 packaging/linux/dolphin-files.desktop \
    "$pkgdir/usr/share/kio/servicemenus/zarg-files.desktop"
  install -Dm644 packaging/linux/dolphin-archives.desktop \
    "$pkgdir/usr/share/kio/servicemenus/zarg-archives.desktop"
  install -Dm755 packaging/linux/nautilus-script.sh "$pkgdir/usr/lib/$pkgname/nautilus-script"
  install -Dm644 packaging/linux/thunar-uca.xml "$pkgdir/usr/share/zar-rs/thunar-uca.xml"
  install -Dm755 packaging/linux/install-thunar-actions.py \
    "$pkgdir/usr/bin/zarg-install-thunar-actions"
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
  install -Dm644 zarlib-gui/assets/crystal/README.md \
    "$pkgdir/usr/share/licenses/$pkgname/crystal-icons.md"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 zarmcp/README.md "$pkgdir/usr/share/doc/$pkgname/zarmcp.md"
  install -Dm644 zarmount/README.md "$pkgdir/usr/share/doc/$pkgname/zarmount.md"
  mkdir -p "$pkgdir/usr/share/nautilus/scripts"
  local script_name
  for script_name in \
    "ZAR - Open Archive" \
    "ZAR - Extract here" \
    "ZAR - Extract to..." \
    "ZAR - Create Archive..." \
    "ZAR - Convert to ZAR" \
    "ZAR - Mount Archive"; do
    ln -s "/usr/lib/$pkgname/nautilus-script" "$pkgdir/usr/share/nautilus/scripts/$script_name"
  done
}
