[Desktop Entry]
Type=Service
MimeType=application/x-zar;
Actions=openArchive;extractHere;extractTo;extractToFolder;testArchive;mountArchive

[Desktop Action openArchive]
Name=Open Archive
Icon=zarg
Exec=zarg --context open -- %F

[Desktop Action extractHere]
Name=Extract here
Icon=zarg
Exec=zarg --context extract-here -- %F

[Desktop Action extractTo]
Name=Extract to...
Icon=zarg
Exec=zarg --context extract-to -- %F

[Desktop Action extractToFolder]
Name=Extract to archive folder
Icon=zarg
Exec=zarg --context extract-to-folder -- %F

[Desktop Action testArchive]
Name=Test Archive
Icon=zarg
Exec=zarg --context test -- %F

[Desktop Action mountArchive]
Name=Mount Archive
Icon=zarg
Exec=zarmount --ask %F
