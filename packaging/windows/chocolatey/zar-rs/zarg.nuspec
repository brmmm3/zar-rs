<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>zar-rs</id>
    <version>0.13.0</version>
    <title>zar-rs</title>
    <authors>Martin Bammer</authors>
    <owners>brmmm3</owners>
    <projectUrl>https://github.com/brmmm3/zar-rs</projectUrl>
    <licenseUrl>https://github.com/brmmm3/zar-rs/blob/master/LICENSE-MIT</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>ZAR is an archive format and toolkit with compression, deduplication, and
      commit-based history. It is written in Rust and includes a command-line tool,
      a desktop GUI, a reusable library, language bindings, and a network copy tool.
      This package contains binaries for x86_64 and aarch64 architectures.</description>
    <tags>zarg zarc zcopy zar archiver compression</tags>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>